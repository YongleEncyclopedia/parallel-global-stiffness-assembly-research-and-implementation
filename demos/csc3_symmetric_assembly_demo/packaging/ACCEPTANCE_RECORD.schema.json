{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YongleEncyclopedia/parallel-global-stiffness-assembly-research-and-implementation/blob/main/demos/csc3_symmetric_assembly_demo/packaging/ACCEPTANCE_RECORD.schema.json",
  "title": "CSC3 Demo Formal Acceptance Record",
  "description": "Machine-readable record for one INTERNAL EVALUATION ONLY controlled-host delivery decision. Human approvals are organization identity references, not fabricated signatures.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "delivery_id",
    "issue_url",
    "source_commit",
    "distribution",
    "recipient",
    "operator",
    "technical_reviewer",
    "controlled_host",
    "toolchain",
    "input",
    "execution",
    "correctness",
    "performance",
    "artifacts",
    "verifications",
    "deviations",
    "approvals",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "csc3-demo-formal-acceptance-v1"
    },
    "delivery_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "issue_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://github\\.com/.+/issues/44$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "distribution": {
      "const": "INTERNAL EVALUATION ONLY"
    },
    "recipient": {
      "$ref": "#/$defs/party"
    },
    "operator": {
      "$ref": "#/$defs/party"
    },
    "technical_reviewer": {
      "$ref": "#/$defs/party"
    },
    "controlled_host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controlled_host_id",
        "system",
        "architecture",
        "hostname",
        "cpu_vendor",
        "cpu_model",
        "physical_core_count",
        "logical_core_count",
        "total_memory_bytes",
        "preflight_sha256"
      ],
      "properties": {
        "controlled_host_id": {
          "$ref": "#/$defs/nonempty"
        },
        "system": {
          "type": [
            "string",
            "null"
          ]
        },
        "architecture": {
          "type": [
            "string",
            "null"
          ]
        },
        "hostname": {
          "$ref": "#/$defs/nullable_nonempty"
        },
        "cpu_vendor": {
          "type": [
            "string",
            "null"
          ]
        },
        "cpu_model": {
          "anyOf": [
            {
              "$ref": "#/$defs/nonempty"
            },
            {
              "type": "null"
            }
          ]
        },
        "physical_core_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "logical_core_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "total_memory_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "preflight_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compiler",
        "compiler_version",
        "cmake_version",
        "ninja_version",
        "python_version",
        "git_version",
        "git_lfs_version",
        "openmp_found",
        "openmp_required"
      ],
      "properties": {
        "compiler": {
          "$ref": "#/$defs/nullable_nonempty"
        },
        "compiler_version": {
          "$ref": "#/$defs/nullable_nonempty"
        },
        "cmake_version": {
          "$ref": "#/$defs/nullable_nonempty"
        },
        "ninja_version": {
          "$ref": "#/$defs/nullable_nonempty"
        },
        "python_version": {
          "$ref": "#/$defs/nullable_nonempty"
        },
        "git_version": {
          "$ref": "#/$defs/nullable_nonempty"
        },
        "git_lfs_version": {
          "$ref": "#/$defs/nullable_nonempty"
        },
        "openmp_found": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "openmp_required": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case",
        "repository_relative_path",
        "size_bytes",
        "sha256",
        "tracked",
        "materialized",
        "matches_head_lfs",
        "head_lfs_oid_sha256",
        "head_lfs_size_bytes"
      ],
      "properties": {
        "case": {
          "const": "windhub"
        },
        "repository_relative_path": {
          "const": "examples/3d-WindTurbineHub.inp"
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "tracked": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "materialized": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "matches_head_lfs": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "head_lfs_oid_sha256": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "head_lfs_size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "started_at_utc",
        "ended_at_utc"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/step_status"
        },
        "evidence_level": {
          "const": "formal"
        },
        "report_intent": {
          "const": "delivery"
        },
        "preset": {
          "const": "delivery"
        },
        "warmup_count": {
          "type": "integer",
          "minimum": 2
        },
        "repeat_count": {
          "type": "integer",
          "minimum": 7
        },
        "amortization_count": {
          "const": 1
        },
        "requested_thread_counts": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 5,
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "allOf": [
            {
              "contains": {
                "const": 1
              }
            },
            {
              "contains": {
                "const": 2
              }
            },
            {
              "contains": {
                "const": 4
              }
            },
            {
              "contains": {
                "const": 8
              }
            },
            {
              "contains": {
                "const": 16
              }
            }
          ]
        },
        "physical_core_thread_included": {
          "const": true
        },
        "omp_dynamic": {
          "const": "false"
        },
        "omp_proc_bind": {
          "const": "close"
        },
        "omp_places": {
          "const": "cores"
        },
        "started_at_utc": {
          "$ref": "#/$defs/date_time"
        },
        "ended_at_utc": {
          "$ref": "#/$defs/date_time"
        }
      }
    },
    "correctness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/step_status"
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "frobenius_relative_error_maximum",
            "maximum_absolute_error",
            "displacement_relative_error_maximum",
            "relative_residual_maximum"
          ],
          "properties": {
            "frobenius_relative_error_maximum": {
              "const": 1e-08
            },
            "maximum_absolute_error": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "absolute_term",
                "scale_term",
                "scale_quantity"
              ],
              "properties": {
                "absolute_term": {
                  "const": 1e-10
                },
                "scale_term": {
                  "const": 1e-08
                },
                "scale_quantity": {
                  "const": "max_abs_serial_matrix_entry"
                }
              }
            },
            "displacement_relative_error_maximum": {
              "const": 1e-08
            },
            "relative_residual_maximum": {
              "const": 1e-10
            }
          }
        },
        "tet4": {
          "$ref": "#/$defs/correctness_case"
        },
        "hex8": {
          "$ref": "#/$defs/correctness_case"
        }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/step_status"
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "numeric_speedup_minimum",
            "symbolic_speedup_exclusive_minimum",
            "maximum_coefficient_of_variation",
            "thread_count_exclusive_minimum"
          ],
          "properties": {
            "numeric_speedup_minimum": {
              "const": 1.5
            },
            "symbolic_speedup_exclusive_minimum": {
              "const": 1.0
            },
            "maximum_coefficient_of_variation": {
              "const": 0.05
            },
            "thread_count_exclusive_minimum": {
              "const": 1
            }
          }
        },
        "numeric_thread_count": {
          "type": "integer",
          "exclusiveMinimum": 1
        },
        "numeric_speedup": {
          "type": "number",
          "minimum": 0
        },
        "numeric_coefficient_of_variation": {
          "type": "number",
          "minimum": 0
        },
        "symbolic_thread_count": {
          "type": "integer",
          "exclusiveMinimum": 1
        },
        "symbolic_speedup": {
          "type": "number",
          "minimum": 0
        },
        "symbolic_coefficient_of_variation": {
          "type": "number",
          "minimum": 0
        },
        "raw_sample_count": {
          "type": "integer",
          "minimum": 1
        },
        "samples_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "summary_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "thresholds",
              "numeric_thread_count",
              "numeric_speedup",
              "numeric_coefficient_of_variation",
              "symbolic_thread_count",
              "symbolic_speedup",
              "symbolic_coefficient_of_variation",
              "raw_sample_count",
              "samples_sha256",
              "summary_sha256"
            ],
            "properties": {
              "numeric_speedup": {
                "minimum": 1.5
              },
              "numeric_coefficient_of_variation": {
                "maximum": 0.05
              },
              "symbolic_speedup": {
                "exclusiveMinimum": 1.0
              },
              "symbolic_coefficient_of_variation": {
                "maximum": 0.05
              }
            }
          }
        }
      ]
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runbook_log",
        "outcome_record"
      ],
      "properties": {
        "run_manifest": {
          "$ref": "#/$defs/artifact"
        },
        "ctest_junit": {
          "$ref": "#/$defs/artifact"
        },
        "benchmark_samples": {
          "$ref": "#/$defs/artifact"
        },
        "benchmark_summary": {
          "$ref": "#/$defs/artifact"
        },
        "evidence_summary": {
          "$ref": "#/$defs/artifact"
        },
        "canonical_markdown_report": {
          "$ref": "#/$defs/artifact"
        },
        "host_preflight": {
          "$ref": "#/$defs/artifact"
        },
        "runbook_log": {
          "description": "Complete stdout/stderr transcript captured immediately after RUN_ROOT creation.",
          "$ref": "#/$defs/artifact"
        },
        "outcome_record": {
          "description": "Machine-readable status, reason, phase, failed command, and exit code written by the runbook EXIT trap.",
          "$ref": "#/$defs/artifact"
        },
        "source_commit_file": {
          "$ref": "#/$defs/artifact"
        },
        "sha256sums_file": {
          "$ref": "#/$defs/artifact"
        },
        "deterministic_package_record": {
          "description": "Hash-bound record proving the two package paths were byte-identical.",
          "$ref": "#/$defs/artifact"
        },
        "manifest_only_verifier_output": {
          "description": "JSON output from manifest-only verification.",
          "$ref": "#/$defs/artifact"
        },
        "clean_room_verifier_log": {
          "description": "Combined build/test log and final JSON from full clean-room verification.",
          "$ref": "#/$defs/artifact"
        },
        "delivery_zip": {
          "$ref": "#/$defs/artifact"
        },
        "presentation_pdf": {
          "description": "Optional presentation derivative. It never replaces the canonical Markdown report.",
          "$ref": "#/$defs/artifact"
        }
      }
    },
    "verifications": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/step_status"
        },
        "source_and_input_identity": {
          "$ref": "#/$defs/verification"
        },
        "ctest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "$ref": "#/$defs/step_status"
            },
            "test_count": {
              "type": "integer",
              "minimum": 0
            },
            "failed_count": {
              "type": "integer",
              "minimum": 0
            },
            "skipped_count": {
              "type": "integer",
              "minimum": 0
            },
            "not_run_count": {
              "type": "integer",
              "minimum": 0
            },
            "test_names": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/nonempty"
              }
            },
            "evidence_reference": {
              "$ref": "#/$defs/nonempty"
            }
          }
        },
        "report_recomputation": {
          "$ref": "#/$defs/verification"
        },
        "deterministic_package": {
          "$ref": "#/$defs/verification"
        },
        "manifest_only": {
          "$ref": "#/$defs/verification"
        },
        "clean_room": {
          "$ref": "#/$defs/verification"
        }
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identifier",
          "description",
          "impact",
          "disposition"
        ],
        "properties": {
          "identifier": {
            "$ref": "#/$defs/nonempty"
          },
          "description": {
            "$ref": "#/$defs/nonempty"
          },
          "impact": {
            "$ref": "#/$defs/nonempty"
          },
          "disposition": {
            "enum": [
              "ACCEPTED_INTERNAL_ONLY",
              "REJECTED",
              "OPEN_BLOCKER"
            ]
          },
          "approval_reference": {
            "$ref": "#/$defs/nonempty",
            "pattern": "\\S"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "disposition": {
                  "const": "ACCEPTED_INTERNAL_ONLY"
                }
              },
              "required": [
                "disposition"
              ]
            },
            "then": {
              "required": [
                "approval_reference"
              ]
            }
          }
        ]
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator",
        "technical_reviewer",
        "delivery_approver",
        "recipient_acknowledgement"
      ],
      "properties": {
        "operator": {
          "$ref": "#/$defs/approval"
        },
        "technical_reviewer": {
          "$ref": "#/$defs/approval"
        },
        "delivery_approver": {
          "$ref": "#/$defs/approval"
        },
        "recipient_acknowledgement": {
          "$ref": "#/$defs/approval"
        }
      }
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    }
  },
  "$defs": {
    "nonempty": {
      "type": "string",
      "minLength": 1
    },
    "nullable_nonempty": {
      "anyOf": [
        {
          "$ref": "#/$defs/nonempty"
        },
        {
          "type": "null"
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullable_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "date_time": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "step_status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_RUN"
      ]
    },
    "party": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organization",
        "department",
        "identity_reference"
      ],
      "properties": {
        "organization": {
          "$ref": "#/$defs/nonempty"
        },
        "department": {
          "$ref": "#/$defs/nonempty"
        },
        "identity_reference": {
          "$ref": "#/$defs/nonempty"
        },
        "authorization_reference": {
          "$ref": "#/$defs/nonempty"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "correctness_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/step_status"
        },
        "structure_equal": {
          "type": "boolean"
        },
        "values_finite": {
          "type": "boolean"
        },
        "scatter_indices_valid": {
          "type": "boolean"
        },
        "frobenius_relative_error": {
          "type": "number",
          "minimum": 0
        },
        "maximum_absolute_error": {
          "type": "number",
          "minimum": 0
        },
        "maximum_absolute_serial_entry": {
          "type": "number",
          "minimum": 0
        },
        "maximum_absolute_error_tolerance": {
          "description": "Computed as 1e-10 + 1e-8 * maximum_absolute_serial_entry; the report generator independently verifies this cross-field relation.",
          "type": "number",
          "minimum": 0
        },
        "maximum_absolute_error_within_tolerance": {
          "description": "True only when maximum_absolute_error is no greater than maximum_absolute_error_tolerance.",
          "type": "boolean"
        },
        "displacement_relative_error": {
          "type": "number",
          "minimum": 0
        },
        "relative_residual": {
          "type": "number",
          "minimum": 0
        },
        "evidence_reference": {
          "$ref": "#/$defs/nonempty"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "PASS",
                  "FAIL"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "structure_equal",
              "values_finite",
              "scatter_indices_valid",
              "frobenius_relative_error",
              "maximum_absolute_error",
              "maximum_absolute_serial_entry",
              "maximum_absolute_error_tolerance",
              "maximum_absolute_error_within_tolerance",
              "displacement_relative_error",
              "relative_residual",
              "evidence_reference"
            ]
          }
        }
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/step_status"
        },
        "evidence_reference": {
          "$ref": "#/$defs/nonempty"
        },
        "details": {
          "$ref": "#/$defs/nonempty"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "PASS",
                  "FAIL"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "evidence_reference"
            ]
          }
        }
      ]
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_reference",
        "acknowledgement"
      ],
      "properties": {
        "identity_reference": {
          "$ref": "#/$defs/nonempty"
        },
        "acknowledgement": {
          "enum": [
            "ACKNOWLEDGED",
            "REJECTED",
            "PENDING"
          ]
        },
        "acknowledged_at_utc": {
          "$ref": "#/$defs/date_time"
        },
        "approval_record_reference": {
          "$ref": "#/$defs/nonempty"
        },
        "delivery_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "archive_filename": {
          "type": "string",
          "pattern": "^csc3-symmetric-assembly-demo-v0\\.2\\.0\\+[0-9a-f]{12}\\.zip$"
        },
        "archive_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_status": {
          "const": "PACKAGE_CANDIDATE"
        },
        "clean_room_status": {
          "const": "PASS"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "acknowledgement": {
                "enum": [
                  "ACKNOWLEDGED",
                  "REJECTED"
                ]
              }
            },
            "required": [
              "acknowledgement"
            ]
          },
          "then": {
            "required": [
              "acknowledged_at_utc",
              "approval_record_reference",
              "delivery_id",
              "source_commit",
              "archive_filename",
              "archive_sha256",
              "candidate_status",
              "clean_room_status"
            ]
          }
        }
      ]
    }
  },
  "allOf": [
    {
