{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "submission",
      "displayName": "研究院交付构建",
      "description": "Release、OpenMP、严格警告和 9 个核心 C++ 测试",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/submission",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CSC3_DEMO_REQUIRE_OPENMP": "ON",
        "CSC3_DEMO_WARNINGS_AS_ERRORS": "ON",
        "CSC3_DEMO_BUILD_CPP_TESTS": "ON",
        "CSC3_DEMO_BUILD_ACCEPTANCE_TESTS": "OFF",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "delivery",
      "displayName": "CSC3 delivery",
      "description": "Release delivery build with required OpenMP, strict warnings, and tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/delivery",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CSC3_DEMO_REQUIRE_OPENMP": "ON",
        "CSC3_DEMO_WARNINGS_AS_ERRORS": "ON",
        "CSC3_DEMO_BUILD_CPP_TESTS": "ON",
        "CSC3_DEMO_BUILD_ACCEPTANCE_TESTS": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "ci-sanitizers",
      "displayName": "CSC3 sanitizer CI",
      "description": "Debug CI build with required OpenMP, strict warnings, ASan, and UBSan",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ci-sanitizers",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CSC3_DEMO_REQUIRE_OPENMP": "ON",
        "CSC3_DEMO_WARNINGS_AS_ERRORS": "ON",
        "CSC3_DEMO_ENABLE_SANITIZERS": "ON",
        "CSC3_DEMO_BUILD_CPP_TESTS": "ON",
        "CSC3_DEMO_BUILD_ACCEPTANCE_TESTS": "OFF",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "submission",
      "configurePreset": "submission"
    },
    {
      "name": "delivery",
      "configurePreset": "delivery"
    },
    {
      "name": "ci-sanitizers",
      "configurePreset": "ci-sanitizers"
    }
  ],
  "testPresets": [
    {
      "name": "submission",
      "configurePreset": "submission",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "delivery",
      "configurePreset": "delivery",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "ci-sanitizers",
      "configurePreset": "ci-sanitizers",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
